# Private vault data. Keep only the empty directory markers and seed journal.
/00_收件箱/*
!/00_收件箱/.gitkeep
/01_资料来源/*
!/01_资料来源/.gitkeep
/02_知识笔记/*
!/02_知识笔记/.gitkeep
!/02_知识笔记/_演化/
/02_知识笔记/_演化/*
!/02_知识笔记/_演化/知识成长记录.md
/03_项目/*
!/03_项目/.gitkeep
/04_创作成果/*
!/04_创作成果/.gitkeep
/99_系统/_运行数据/*
!/99_系统/_运行数据/日志/
/99_系统/_运行数据/日志/*
!/99_系统/_运行数据/日志/系统日志.md
/99_系统/创作记忆/*
!/99_系统/创作记忆/创作者档案.md
!/99_系统/创作记忆/创作记录.md
/.obsidian/plugins/kb-local-tools/data.json
/.obsidian/workspace*.json
/.obsidian/bookmarks.json
/.obsidian/appearance-mobile.json
/.obsidian/plugins/*/data.json
!/.obsidian/plugins/xiaohongshu-importer/data.json
/.kb-lock
.DS_Store
__pycache__/
*.py[cod]
*.sqlite*
.env*
